# AIOS boot splash: logo, three pulsing dots, the current boot message.
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.008, 0.016, 0.031);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30);

dot.image = Image("dot.png");
for (i = 0; i < 3; i++) {
  dots[i] = Sprite(dot.image);
  dots[i].SetX(Window.GetX() + Window.GetWidth() / 2 - 40 + i * 32);
  dots[i].SetY(logo.sprite.GetY() + logo.image.GetHeight() + 40);
}

frame = 0;
fun refresh_callback() {
  frame++;
  # Something on the console can clear the screen after the first paint, and
  # plymouth only repaints what changes: touch the still parts twice a second.
  if (frame % 25 == 0) {
    Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
    Window.SetBackgroundBottomColor(0.008, 0.016, 0.031);
    logo.sprite.SetOpacity(0.999 + 0.001 * ((frame / 25) % 2));
  }
  for (i = 0; i < 3; i++) {
    phase = Math.Sin((frame / 12) - i * 0.9);
    dots[i].SetOpacity(0.25 + 0.75 * (phase + 1) / 2);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Password prompts cannot occur (no encrypted disks); boot status is not drawn.
fun quit_callback() {
  for (i = 0; i < 3; i++) dots[i].SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
